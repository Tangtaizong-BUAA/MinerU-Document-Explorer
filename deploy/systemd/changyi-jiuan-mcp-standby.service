[Unit]
Description=Changyi Jiuan MCP read-only Alibaba fallback
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=changyi-kb
Group=changyi-kb
WorkingDirectory=/opt/changyi-jiuan-mcp/current
Environment=NODE_ENV=production
Environment=HOME=/var/lib/changyi-kb-standby
Environment=CYJ_MCP_PROFILE=project-read
Environment=CYJ_KB_ROOT=/var/lib/changyi-kb-standby/data
Environment=CYJ_MCP_HOST=127.0.0.1
Environment=CYJ_MCP_PORT=8794
EnvironmentFile=-/etc/changyi-jiuan-mcp.env
ExecStart=/usr/local/bin/node /opt/changyi-jiuan-mcp/current/dist/cli/project-mcp-http.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/changyi-kb-standby
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=384M
CPUQuota=40%
TasksMax=128

[Install]
WantedBy=multi-user.target
