# Include this upstream in the nginx http context. The FRP port is protected by
# deploy/systemd/cyj-frp-loopback-firewall.service and must not be public.
upstream cyj_mcp_home_primary {
    server 127.0.0.1:60193 max_fails=1 fail_timeout=5s;
    server 127.0.0.1:8794 backup;
    keepalive 8;
}

# Place this location in the TLS-enabled server block. The home project-contribute
# node is primary; Alibaba's project-read snapshot is an automatic fallback.
location = /cyj/mcp {
    proxy_pass http://cyj_mcp_home_primary/mcp;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_cache off;
    proxy_connect_timeout 2s;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_next_upstream error timeout http_502 http_503 http_504 non_idempotent;
    proxy_next_upstream_tries 2;
    client_max_body_size 20M;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header X-CYJ-Upstream $upstream_addr always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
}

# Optional deployment-only route. It never falls back, so a successful probe
# proves that traffic reached the home node before the main route is switched.
location = /cyj-home/mcp {
    proxy_pass http://127.0.0.1:60193/mcp;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_cache off;
    proxy_connect_timeout 2s;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    client_max_body_size 20M;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header X-CYJ-Upstream $upstream_addr always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
}
